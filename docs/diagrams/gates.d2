# Who does what, and when the run waits for you (small and medium features).
# Render with `mise run diagrams`; the SVG is docs/img/gates.svg.
shape: sequence_diagram

classes: {
  # always stops
  gate: {style: {stroke: "#d17a00"; stroke-width: 3; font-color: "#d17a00"; bold: true}}
  # stops only when something needs your call
  maybe: {style: {stroke: "#d17a00"; stroke-width: 2; stroke-dash: 4; font-color: "#d17a00"}}
  back: {style.stroke-dash: 3}
}

you: You {shape: person}
cc: Claude Code\n(coordinator)
agents: Agents\n(one fresh per phase)

you -> cc: an idea, via /brief
cc -> agents: review the brief
cc -> you: confirm the brief {class: gate}
you -> cc: /feat on the brief, in a fresh context
cc -> agents: specify
cc -> you: answer its open questions, if any {class: maybe}
cc -> agents: plan + design review
cc -> you: check the spec, decide on the findings {class: maybe}
cc -> agents: tasks + consistency check
cc -> you: fix serious gaps, if any {class: maybe}
cc -> agents: implement, story by story
cc -> agents: code review
cc -> you: pick the fixes {class: gate}
cc -> agents: apply fixes, ship
agents -> you: pull request, yours to merge {class: back}
